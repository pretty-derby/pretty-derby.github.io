---
import SkillDetailPage from "../../astro-pages/SkillDetailPage";
import AppShell from "../../layouts/AppShell.astro";
import { readDB } from "../../lib/db.server";

export async function getStaticPaths() {
  const db = await readDB();

  return db.skills.map((skill) => ({
    params: { id: skill.id },
    props: { skill },
  }));
}

const { id } = Astro.params;
const { skill } = Astro.props;
---

<AppShell title={`${skill.name} - 技能 - 乌拉拉大胜利 - 赛马娘资料站`}>
  <SkillDetailPage id={id} client:load />
</AppShell>
