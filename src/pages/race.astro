---
import AppShell from "../layouts/AppShell.astro";
import RaceStatic from "../components/race/RaceStatic.astro";
import { readDB, readLocale } from "../lib/db.server";

const db = await readDB();
const messages = await readLocale("zh_CN");
---

<AppShell title="比赛 - 乌拉拉大胜利 - 赛马娘资料站">
  <RaceStatic races={db.races} messages={messages} />
</AppShell>
