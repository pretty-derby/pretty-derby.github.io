---
import SupportDetailPage from "../../astro-pages/SupportDetailPage";
import AppShell from "../../layouts/AppShell.astro";
import { readDB } from "../../lib/db.server";

export async function getStaticPaths() {
  const db = await readDB();

  return db.supports.map((support) => ({
    params: { id: support.id },
    props: { support },
  }));
}

const { id } = Astro.params;
const { support } = Astro.props;
---

<AppShell title={`${support.name} - 支援卡 - 乌拉拉大胜利 - 赛马娘资料站`}>
  <SupportDetailPage id={id} client:load />
</AppShell>
